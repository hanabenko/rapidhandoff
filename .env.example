GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=<your-project-id>
GOOGLE_CLOUD_LOCATION=us-central1
PORT=8080
LIVE_MCP=false
# Comma-separated origins are supported for direct browser-to-backend requests.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Uses Google Application Default Credentials:
# gcloud auth application-default login
MONGODB_URI=<your-mongodb-connection-string>

# Local MCP servers are launched with npx.
MONGODB_MCP_DATABASE=er_system
MDB_MCP_READ_ONLY=false
MDB_MCP_INDEX_CHECK=true

# Optional live MongoDB MCP smoke-test settings.
MCP_SMOKE_DATABASE=er_system_smoke
MCP_SMOKE_KEEP_DATA=false
MCP_SMOKE_INDEX_CHECK=false
MCP_SMOKE_TIMEOUT_MS=30000
# Optional stable ID for retaining or cleaning a specific smoke run.
MCP_SMOKE_RUN_ID=

# Optional model override
ER_ORCHESTRATOR_MODEL=gemini-2.5-flash

# Arize/Phoenix MCP and observability
PHOENIX_API_KEY=<phoenix-api-key>
PHOENIX_BASE_URL=https://app.phoenix.arize.com
PHOENIX_PROJECT=<phoenix-project-name>

# OTEL export for production workflow tracing. Set either Phoenix or Arize style
# names for the collector and optional API key/project aliases.
PHOENIX_COLLECTOR_ENDPOINT=
ARIZE_TRACING_ENDPOINT=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=

# Optional remote Phoenix MCP endpoint instead of launching the local stdio
# server with npx.
PHOENIX_MCP_URL=

# Optional Phoenix trace verification window in minutes.
PHOENIX_VERIFY_LAST_N_MINUTES=60
